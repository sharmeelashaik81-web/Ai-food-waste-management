PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_food_waste_ai_2026
JWT_EXPIRES_IN=7d

# Supabase Credentials (Optional for local memory mode, recommended for production)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI API Key (Optional for mock engine mode, recommended for live AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Socket.IO Client Origin
CLIENT_ORIGIN=http://localhost:5173

# Email SMTP Settings (Optional)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=testpass
